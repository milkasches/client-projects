# Copy to .env and fill in.  Never commit the real .env file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where orders and consultation requests are sent
NOTIFY_EMAIL=milkaolder@gmail.com
CONTACT_EMAIL=client@example.com
FACEBOOK_URL=https://www.facebook.com/your-page

# Gmail sending (leave the password empty to print emails in the terminal instead)
# Create an App Password: https://myaccount.google.com/apppasswords  (needs 2-step verification)
EMAIL_HOST_USER=milkaolder@gmail.com
EMAIL_HOST_PASSWORD=

# Public address (used in admin links of retried emails)
SITE_URL=http://127.0.0.1:8000

# Housekeeping: daily backup + resend failed emails + delete old closed requests
BACKUP_KEEP=14
RETENTION_DAYS=365
AUTO_MAINTENANCE=true
